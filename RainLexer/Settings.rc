#include <windows.h>
#include "SettingsResource.h"

1 ICON "Rainmeter.ico"

IDD_EDITOR DIALOGEX 0, 0, 592, 380
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "RainCode++ Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Vocabulary", -1, 8, 7, 232, 317
    COMBOBOX IDC_GROUP, 17, 22, 214, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Edit one term per line. Changes apply after restarting Notepad++.", -1, 17, 42, 214, 23
    EDITTEXT IDC_FIND, 17, 62, 155, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Find next", IDC_FIND_NEXT, 178, 62, 53, 14
    EDITTEXT IDC_TERMS, 17, 82, 214, 209, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Restore category", IDC_RESET_TERMS, 17, 299, 89, 16
    PUSHBUTTON "Save vocabulary", IDC_SAVE_TERMS, 139, 299, 92, 16

    GROUPBOX "Syntax palette", -1, 248, 7, 336, 317
    COMBOBOX IDC_PRESET, 257, 22, 216, 145, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Use preset", IDC_USE_PRESET, 481, 22, 94, 15
    CONTROL "", IDC_PREVIEW, "Static", SS_OWNERDRAW | WS_BORDER, 257, 44, 318, 153
    LTEXT "Set style for syntax types", -1, 257, 204, 318, 11
    COMBOBOX IDC_STYLE_ID, 257, 217, 318, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Foreground", IDC_FOREGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 239, 103, 17
    CONTROL "Background", IDC_BACKGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 365, 239, 103, 17
    PUSHBUTTON "Set font...", IDC_FONT, 473, 239, 52, 17
    PUSHBUTTON "Inherit", IDC_INHERIT_FONT, 530, 239, 45, 17
    PUSHBUTTON "Reload active", IDC_ACTIVE, 257, 263, 97, 16
    PUSHBUTTON "Load palette...", IDC_IMPORT, 365, 263, 100, 16
    PUSHBUTTON "Save palette as...", IDC_EXPORT, 473, 263, 102, 16
    CONTROL "Match Notepad++ light or dark mode", IDC_MATCH_MODE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 257, 283, 220, 13
    LTEXT "Updates open Rainmeter tabs.", IDC_APPLY_HINT, 257, 303, 190, 11
    PUSHBUTTON "Apply", IDC_APPLY, 473, 298, 102, 17

    LTEXT "", IDC_STATUS, 9, 333, 482, 17
    PUSHBUTTON "Open RainLexer backup", IDC_BACKUP, 9, 353, 111, 16
    PUSHBUTTON "Uninstall RainCode++...", IDC_UNINSTALL, 124, 353, 115, 16
    PUSHBUTTON "Close", IDCANCEL, 506, 353, 78, 16
END

IDD_COLOR_PICKER DIALOGEX 0, 0, 236, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose color"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Hex color", -1, 10, 11, 143, 10
    EDITTEXT IDC_HEX_COLOR, 10, 23, 144, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Preview", -1, 164, 11, 62, 10
    CONTROL "", IDC_COLOR_SWATCH, "Static", SS_OWNERDRAW | WS_BORDER, 164, 23, 62, 16
    LTEXT "Paste a six-digit hex code, such as #4681AD.", -1, 10, 45, 216, 12
    PUSHBUTTON "&Browse colors...", IDC_VISUAL_COLOR, 10, 78, 88, 16
    DEFPUSHBUTTON "&OK", IDOK, 116, 78, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 174, 78, 52, 16
END

