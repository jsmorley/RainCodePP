#include <windows.h>
#include "SettingsResource.h"

1 ICON "Rainmeter.ico"

IDD_EDITOR DIALOGEX 0, 0, 592, 352
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "RainSyntax Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Vocabulary", -1, 8, 7, 232, 298
    COMBOBOX IDC_GROUP, 17, 22, 214, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Add a term on the blank line at the top. Changes apply after restarting Notepad++.", -1, 17, 42, 214, 23
    EDITTEXT IDC_FIND, 17, 62, 155, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Find next", IDC_FIND_NEXT, 178, 62, 53, 14
    EDITTEXT IDC_TERMS, 17, 82, 214, 194, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Restore category", IDC_RESET_TERMS, 17, 283, 89, 16
    PUSHBUTTON "Save vocabulary", IDC_SAVE_TERMS, 139, 283, 92, 16

    GROUPBOX "Syntax palette", -1, 248, 7, 336, 298
    COMBOBOX IDC_PRESET, 257, 22, 216, 145, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Use preset", IDC_USE_PRESET, 481, 22, 94, 15
    CONTROL "", IDC_PREVIEW, "Static", SS_OWNERDRAW | WS_BORDER, 257, 44, 318, 153
    LTEXT "Set style for syntax types", -1, 257, 204, 318, 11
    COMBOBOX IDC_STYLE_ID, 257, 217, 318, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Foreground", IDC_FOREGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 239, 103, 17
    CONTROL "Background", IDC_BACKGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 365, 239, 103, 17
    PUSHBUTTON "Set all backgrounds", IDC_ALL_BACKGROUNDS, 473, 239, 103, 17
    PUSHBUTTON "Set font", IDC_FONT, 257, 260, 103, 17
    PUSHBUTTON "Apply", IDC_APPLY, 473, 260, 102, 17
    PUSHBUTTON "Reload active", IDC_ACTIVE, 257, 283, 97, 16
    PUSHBUTTON "Load palette", IDC_IMPORT, 365, 283, 100, 16
    PUSHBUTTON "Save palette as...", IDC_EXPORT, 473, 283, 102, 16

    LTEXT "", IDC_STATUS, 9, 308, 482, 17
    PUSHBUTTON "Open RainLexer backup", IDC_BACKUP, 9, 328, 111, 16
    PUSHBUTTON "Uninstall RainSyntax", IDC_UNINSTALL, 124, 328, 115, 16
    PUSHBUTTON "Close", IDCANCEL, 506, 328, 78, 16
END

IDD_COLOR_PICKER DIALOGEX 0, 0, 236, 109
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose color"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Hex color", -1, 10, 11, 143, 10
    EDITTEXT IDC_HEX_COLOR, 10, 23, 144, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Preview", -1, 164, 11, 62, 10
    CONTROL "", IDC_COLOR_SWATCH, "Static", SS_OWNERDRAW | WS_BORDER, 164, 23, 62, 16
    LTEXT "&Red (0-255)", -1, 10, 47, 44, 10
    EDITTEXT IDC_RED_COLOR, 10, 59, 44, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Green (0-255)", -1, 60, 47, 44, 10
    EDITTEXT IDC_GREEN_COLOR, 60, 59, 44, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Bl&ue (0-255)", -1, 110, 47, 44, 10
    EDITTEXT IDC_BLUE_COLOR, 110, 59, 44, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse colors", IDC_VISUAL_COLOR, 10, 84, 88, 16
    DEFPUSHBUTTON "&OK", IDOK, 116, 84, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 174, 84, 52, 16
END

